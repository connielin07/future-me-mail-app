PORT=8080

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=futureme
DB_PASS=replace-with-your-password
DB_NAME=futureme

# Firebase/FCM credentials (path to service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/fcm-service-account.json

# Optional SMTP settings (fill these in when ready to send emails)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=app-password

# Example for Resend (username 固定填 resend，FROM 用你驗證過的網域信箱):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxx_api_key
# SMTP_FROM="FutureMe <no-reply@futuremail.cocotoget.com>"

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=username
SMTP_PASS=password
SMTP_FROM="FutureMe <no-reply@example.com>"
