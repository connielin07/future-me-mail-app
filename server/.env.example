PORT=8080

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=futureme
DB_PASS=replace-with-your-password
DB_NAME=futureme

# Firebase/FCM credentials (path to service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/fcm-service-account.json

# Optional SMTP settings (fill these in when ready to send emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=username
SMTP_PASS=password
