<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    功能說明：
    本頁為 App 首頁主畫面，包含：
    1. 上方 Material Toolbar（顯示 App 標題與選單）
    2. 中間可捲動的首頁內容（引文與操作按鈕）
    3. 底部 BottomNavigationView（主要功能導覽）
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
        MaterialToolbar：頁面最上方工具列
        - 使用 Material Design 元件
        - 顯示 App 名稱「信運草」
        - 掛載右上角選單（menu_main）
        - 背景色與文字顏色皆來自 Theme，支援日夜模式
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:title="信運草"
        app:titleTextColor="?attr/colorOnPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_main" />

    <!--
        ScrollView：首頁主要內容區域
        - 讓內容在畫面高度不足時可以上下捲動
        - fillViewport=true 確保內容至少撐滿畫面高度
        - 上方接 Toolbar，下方接 BottomNavigationView
    -->
    <ScrollView
        android:id="@+id/scrollHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_main"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
            LinearLayout（垂直）
            - 作為 ScrollView 內的實際內容容器
            - 垂直排列引文與按鈕區
            - padding 提供整體留白，提升閱讀體驗
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!--
                TextView：首頁引文文字
                - 作為 App 核心理念與情感引導
                - 使用多行文字與換行符號呈現段落感
                - lineSpacingExtra 增加行距，提升可讀性
            -->
            <TextView
                android:id="@+id/tvQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="生活總是匆匆向前走，有時我們來不及停下腳步，&#10;好好聽聽自己此刻的心情。&#10;&#10;於是，我們把那些想說的話、想記住的瞬間、&#10;還有努力生活的痕跡交給時間。&#10;&#10;寫下一封給未來自己的信，&#10;或許是提醒、是期待、是願望、&#10;也可能只是想告訴未來的自己：&#10;——你一路走到這裡，真的很不容易。&#10;&#10;當某一天通知響起，&#10;那封來自過去的心意將再次被打開，&#10;提醒你：你一直在成長，也一直在陪伴自己。"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <!--
                按鈕區塊（水平排列）
                - 置中顯示兩個主要操作按鈕
                - 提供進入核心功能與教學說明的入口
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <!--
                    Button：開始寫信
                    - 導向寫信功能頁面
                    - 作為使用者的主要行動（Primary Action）
                -->
                <Button
                    android:id="@+id/btnGoWrite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="開始寫信"
                    android:layout_marginEnd="16dp" />

                <!--
                    Button：操作教學
                    - 導向教學 / 說明頁面
                    - 協助首次使用者理解系統操作流程
                -->
                <Button
                    android:id="@+id/btnGoTutorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="操作教學" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!--
        BottomNavigationView：底部導覽列
        - 提供 App 主要功能頁面的切換
        - 高度固定為 75dp，確保點擊區域足夠
        - 選單項目定義於 bottom_nav_menu
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="75dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
