<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InstructActivity">

    <!-- 可捲動內容：教學文字 + 教學影片 -->
    <ScrollView
        android:id="@+id/scrollInstruct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 主標題 -->
            <TextView
                android:id="@+id/tvInstructionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="操作教學：使用信運草Tips"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- 次標題：如何撰寫信件？ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="如何撰寫信件？"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 在首頁點選「開始寫信」進入寫信頁面。
                \n\n2. 設定寄送日期，輸入主旨與內容。
                \n\n3. 點擊「送出」後，信件會儲存到系統並排程提醒。
                \n\n4. 可在「收信總覽」的月曆上查看即將收到的信件。"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- 次標題：如何收信？ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="如何收信？"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 到達收信日當天，手機會跳出收信通知。
                \n\n2. 開啟 APP 進入「收信總覽」。
                \n\n3. 可在信箱查看已送達的信件，點開即可閱讀。"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- 教學影片標題 -->
            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="教學影片"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- 教學影片 (位置在中間、可捲動到) -->
            <VideoView
                android:id="@+id/videoTutorial"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="30dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部導覽列（永遠固定） -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="75dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
