<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_instruct.xml
    功能說明：
    本頁為「操作教學」頁面，主要用途為：
    1. 以文字步驟說明 App 的使用方式（寫信 / 收信）
    2. 提供教學影片，協助使用者快速理解實際操作流程
    3. 採用可捲動版面，確保在不同裝置尺寸下皆可完整閱讀
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InstructActivity">

    <!--
        MaterialToolbar：操作教學頁的上方工具列
        - 顯示頁面標題「操作教學」
        - 使用 Theme 中定義的主色與文字顏色
        - 與首頁 Toolbar 風格一致，維持整體 UI 一致性
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_instruct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:title="操作教學"
        app:titleTextColor="?attr/colorOnPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        ScrollView：教學內容主要區域
        - 包含文字教學與影片教學
        - fillViewport=true，確保內容不足時仍能撐滿畫面
        - 上方接 Toolbar，下方接 BottomNavigationView
    -->
    <ScrollView
        android:id="@+id/scrollInstruct"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_instruct"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
            LinearLayout（垂直排列）
            - 作為 ScrollView 的內容容器
            - 依序放置教學標題、教學文字與影片區塊
            - padding 提供閱讀時的舒適留白
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!--
                次標題：如何撰寫信件？
                - 以較大的字體與粗體呈現
                - 作為段落區隔，提升教學內容的結構清晰度
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="如何撰寫信件？"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!--
                教學文字：寫信流程說明
                - 使用編號步驟，降低使用者理解成本
                - 以換行符號清楚區隔每個步驟
                - 說明從進入寫信頁到成功排程提醒的完整流程
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 在首頁點選「開始寫信」進入寫信頁面。
                \n\n2. 設定寄送日期，輸入主旨與內容。
                \n\n3. 點擊「送出」後，信件會儲存到系統並排程提醒。
                \n\n4. 可在「收信總覽」的月曆上查看即將收到的信件。"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!--
                次標題：如何收信？
                - 與前一段標題風格一致
                - 清楚區分「寫信」與「收信」兩個使用情境
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="如何收信？"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!--
                教學文字：收信流程說明
                - 說明通知出現、進入 App 與閱讀信件的流程
                - 協助使用者理解系統提醒機制
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 到達收信日當天，手機會跳出收信通知。
                \n\n2. 開啟 APP 進入「收信總覽」。
                \n\n3. 可在信箱查看已送達的信件，點開即可閱讀。"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!--
                教學影片區塊標題
                - 提供視覺化學習方式
                - 與文字教學形成互補
            -->
            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="教學影片"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!--
                教學影片預覽區（FrameLayout）
                - 以 FrameLayout 疊加縮圖與播放圖示
                - 預設顯示縮圖，點擊後由程式碼控制播放行為
                - clickable / focusable 提供良好互動體驗
            -->
            <FrameLayout
                android:id="@+id/videoPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/black"
                android:clickable="true"
                android:focusable="true">

                <!--
                    ImageView：影片縮圖
                    - centerCrop 確保畫面填滿且不變形
                    - 作為尚未播放時的視覺預覽
                -->
                <ImageView
                    android:id="@+id/imgVideoThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/content_desc_video_thumbnail"
                    android:scaleType="centerCrop"
                    android:src="@drawable/instruct_thumbnail" />

                <!--
                    ImageView：播放圖示
                    - 疊加在縮圖中央
                    - 提示使用者可點擊播放影片
                -->
                <ImageView
                    android:id="@+id/imgPlayOverlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:alpha="0.9"
                    android:contentDescription="@string/content_desc_play_video"
                    android:src="@android:drawable/ic_media_play" />

            </FrameLayout>

            <!--
                VideoView：實際播放教學影片的元件
                - 預設為隱藏（gone）
                - 當使用者點擊影片縮圖後，由 Activity 程式碼控制顯示與播放
            -->
            <VideoView
                android:id="@+id/videoTutorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!--
        BottomNavigationView：底部導覽列
        - 固定顯示於畫面底部
        - 提供各主要功能頁面的快速切換
        - 與其他頁面共用相同選單，維持操作一致性
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="75dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
