<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.FutureMeMailApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/green_200</item>
        <item name="colorPrimaryVariant">@color/green_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- 只用這一個來改整個視窗背景 -->
        <item name="android:windowBackground">@color/app_bg</item>

        <!-- 讓 BottomNavigationView 用我們自訂的樣式 -->
        <item name="bottomNavigationStyle">@style/CustomBottomNav</item>

    </style>

    <!-- 自訂 BottomNavigationView 樣式 -->
    <style name="CustomBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/app_bg</item>
    </style>

</resources>
